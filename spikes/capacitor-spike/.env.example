# Clerk publishable key for the dev instance (pk_test_...).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Where the harness calls the API. Baked in at build time; the /protected page
# can override it at runtime (stored in localStorage) so a phone can reach a
# laptop on the LAN without a rebuild.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set to false to load Clerk in non-cookie mode. Only needed if the session
# turns out not to persist on capacitor://localhost — see FINDINGS.md Phase B.
# NEXT_PUBLIC_CLERK_STANDARD_BROWSER=false
